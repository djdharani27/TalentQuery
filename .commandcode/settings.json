{
  "permissions": {
    "allow": [
      "Shell(npm:*)",
      "Shell(node src/index.js --help)",
      "Shell(node ./src/index.js --help)",
      "Shell(node --version)",
      "Shell(node -e \"console.log('hi')\")",
      "Shell(dir:*)",
      "Shell(node --check src/index.js)",
      "Shell(node -e \"const {mkdir,writeFile}=require('fs/promises'); (async()=>{await mkdir('./output',{recursive:true}); await writeFile('./output/_test.txt','ok','utf8'); console.log('wrote');})().catch(e=>console.error('ERR',e.message));\")",
      "Shell(node --check src/brightdata.js)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}